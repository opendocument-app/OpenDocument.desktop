{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the document windows may call.",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:default",
    "opener:default"
  ]
}
