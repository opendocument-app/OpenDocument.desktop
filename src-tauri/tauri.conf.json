{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDocument Reader",
  "version": "../package.json",
  "identifier": "app.opendocument.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenDocument Reader",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Read and edit OpenDocument, Office and PDF files",
    "copyright": "Stefl und Taschauer OG",
    "publisher": "Stefl und Taschauer OG",
    "homepage": "https://opendocument.app",
    "license": "MPL-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
